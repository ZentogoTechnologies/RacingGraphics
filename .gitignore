# Casparcg - cache y logs no van a git
Casparcg/cef-cache/
Casparcg/log/
*.log

# Node
node_modules/
dist/
build/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
desktop.ini

# Configuración local: lleva la firma de los JWT
Backend/.env

# Material de trabajo, no forma parte del sistema
Backend/src/public/_zips/
Backend/src/public/_fotos-evento-anterior/

# Capturas del comando PRINT de CasparCG
Casparcg/media/*.png

# Lanzador: registros de arranque y artefactos del empaquetado.
# El .exe se reconstruye con launcher\construir.bat (24 MB, no va a git).
logs/
launcher/*.spec
race-core-studio.exe

# ── Licenciamiento ───────────────────────────────────────────
# La clave privada firma licencias: quien la tenga puede emitirse uso
# perpetuo del software. No entra a git bajo ninguna circunstancia.
claves/
*.pem

# Licencia instalada en este equipo y su marca de reloj. Son de la
# máquina, no del proyecto.
*.lic
licencia.estado.json
claves-desarrollo/

# Token de un solo uso del asistente de instalación. Es de la máquina.
instalacion.token

# Artefactos del empaquetado del instalador
installer/dist/
installer/build/
installer/*.spec
