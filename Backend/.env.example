# Plantilla de configuración. Copiar a .env y ajustar.
#
#   cp Backend/.env.example Backend/.env
#
# El .env real NO va a git: lleva la firma de los tokens.

MONGO_URI=mongodb://localhost:27017
DB_NAME=race-core-studio

# 0.0.0.0 = atiende por toda la red local, para operar desde otro
# equipo o desde un iPad. El instalador abre el puerto en el Firewall.
API_HOST=0.0.0.0
API_PORT=9600

CASPARCG_HOST=127.0.0.1
CASPARCG_PORT=5250
CASPARCG_CHANNEL=1
CASPARCG_TIMEOUT=5

# Ruta del current.xml que reescribe MyLaps. Suele ser una unidad de red.
TIMING_XML_PATH=W:/current.xml
TIMING_CACHE_SECONDS=0.4

# Firma de los JWT. Generar una propia y no reutilizar esta línea:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarla invalida todas las sesiones abiertas.
JWT_SECRET=cambiar-esta-clave
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# ── Licencia ─────────────────────────────────────────────────
# En una instalación de cliente el instalador pone LICENSE_REQUIRED=true.
# En falso (desarrollo), un equipo sin licencia arranca igual.
LICENSE_REQUIRED=false
LICENSE_FILE=licencia.lic
LICENSE_STATE_FILE=licencia.estado.json
LICENSE_SERVER_URL=https://licencias.zentogo.com
